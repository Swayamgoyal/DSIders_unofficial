# Used by `docker compose run apk`. Copy to .env (git-ignored) and fill in.
# All values are optional: without a key the app uses its offline fallback.
# Values are compiled into the APK, so rebuild after changing them.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Admin account password (username: admin). Debug builds fall back to barabari123.
ADMIN_PASSWORD=

# Groq or another OpenAI-compatible provider instead:
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Linux hosts only: make ./dist owned by you instead of root (run `id -u` / `id -g`).
# HOST_UID=1000
# HOST_GID=1000
